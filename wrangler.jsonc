{
  // Cloudflare Worker for fifilee-design.com
  // - serves the site from ./dist (the dashboard build command copies the site there:
  //     mkdir -p dist && cp -r *.html dc.js img dist/ )
  // - runs worker/index.js for /api/* (the website quick check)
  // The name must match the project name in the Cloudflare dashboard.
  "name": "fifilee-design",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "placement": { "region": "aws:ap-northeast-1" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "heather45681@gmail.com" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "af64a2e49cbd4f98a8d11dad9d2c6702" }
  ]
}
